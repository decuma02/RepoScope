# RepoScope Backend — Environment Configuration
# Copy to .env for local development.

# Project & Environment
REPOSCOPE_ENV=development
REPOSCOPE_LOG_LEVEL=INFO

# Database path — for Railway set to /data/reposcope.db and mount a persistent volume to /data.
# For local dev a relative path is fine.
REPOSCOPE_DB_PATH=data/index/reposcope.db

# CORS — comma-separated list of allowed frontend origins.
# In production set to your Vercel URL, e.g.: https://reposcope.vercel.app
# Leave as * for local dev only.
CORS_ORIGINS=*

# IBM Watsonx / Granite LLM Integration
WATSONX_APIKEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2
