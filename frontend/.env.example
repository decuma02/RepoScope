# RepoScope Frontend — environment variables
# Copy this file to .env.local for local development.

# URL of the deployed Railway backend (no trailing slash).
# Leave empty to use relative paths (works when frontend is served by the backend itself).
# Required on Vercel — set this in the Vercel project dashboard under Settings → Environment Variables.
VITE_API_URL=https://your-railway-backend.up.railway.app

# Set to "true" to run the frontend against fixture data instead of the live API.
# Useful for UI-only development or demos without a backend.
VITE_USE_MOCK=false
